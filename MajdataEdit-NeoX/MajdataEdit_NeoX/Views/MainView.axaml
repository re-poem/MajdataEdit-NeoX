<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
			 xmlns:core="clr-namespace:Dock.Model.Mvvm.Controls;assembly=Dock.Model.Mvvm"
			 xmlns:local="using:MajdataEdit_NeoX"
			 xmlns:vm="using:MajdataEdit_NeoX.ViewModels"
			 xmlns:v="using:MajdataEdit_NeoX.Views"
			 xmlns:c="using:MajdataEdit_NeoX.Controls"
			 xmlns:ll="clr-namespace:Avalonia.PropertyGrid.Localization;assembly=Avalonia.PropertyGrid"
			 mc:Ignorable="d"
			 d:DesignWidth="630" d:DesignHeight="440"
			 x:Class="MajdataEdit_NeoX.Views.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*">
		<Menu Grid.Row="0">
			<MenuItem Header="{ll:Localize Gui_File}">
				<MenuItem Header="{ll:Localize Gui_New}" Command="{Binding NewFileAsync}"/>
				<MenuItem Header="{ll:Localize Gui_Open}" Command="{Binding OpenFileAsync}"/>
				<MenuItem Header="{ll:Localize Gui_Save}" Command="{Binding SaveFile}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Win_Recover}" Command="{Binding OpenRecover}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Gui_ExportVideo}" Command="{Binding Play}" CommandParameter="WsType:PlaybackMode.Record"/>
			</MenuItem>
			<MenuItem x:Name="EditMenu" Header="{ll:Localize Gui_Edit}">
				<MenuItem Header="{ll:Localize Gui_ChartInfo}" Command="{Binding OpenChartInfo}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Gui_FindAndReplace}" Command="{Binding ShowFindReplace}"/>
				<Separator/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_Setting}">
				<MenuItem Header="{ll:Localize Gui_Setting}" Command="{Binding OpenSettings}"/>
				<MenuItem Header="{ll:Localize Gui_CheckUpdate}" Command="{Binding CheckUpdateAsync}" CommandParameter="false"/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_Tools}">
				<MenuItem Header="{ll:Localize Gui_BpmTap}" Command="{Binding OpenBpmTap}"/>
				<Separator/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_About}">
				<MenuItem Header="{ll:Localize Gui_ShortcutOverview}" Command="{Binding OpenShortcut}"/>
				<Separator/>
				<MenuItem Header="Discord" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.Discord}"/>
				<MenuItem Header="QQ" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.QQ}"/>
				<Separator/>
				<MenuItem Header="Github" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.GitHub}"/>
				<MenuItem Header="Github (ViewX)" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.GitHub_ViewX}"/>
				<MenuItem Header="Majnet" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.MajNet}"/>
			</MenuItem>
		</Menu>

		<dock:DockControl Grid.Row="1" 
						  Layout="{Binding Layout}"
						  InitializeLayout="True">
			<dock:DockControl.DataTemplates>
				<DataTemplate DataType="core:Document">
					<Grid>
						<Panel>
							<v:InspectorView
								IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Inspector}"
								DisplayTime="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).CaretTime}"
								DisplayCombo="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).CaretCombo}"
								IsConnected="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).IsConnected}"
								SelectedDifficulty="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).SelectedDifficulty}"
								Level="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Level}"
								Designer="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Designer}"
								Offset="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Offset}"
								PlaybackSpeed="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).PlaybackSpeed}"
								IsFollowCursor="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).IsFollowCursor}" />
							<c:SimaiVisualizerControl
								IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Visualizer}"
								TrackInfo="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).TrackInfo}"
								Chart="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Chart}"
								Time="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).PlayheadTime}" />
							<v:FumenEditorView
								IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Editor}"
								Fumen="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Fumen}" />
							<v:SettingsView
								IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}"
								Settings="{Binding $parent[dock:DockControl].((vm:MainViewModel)DataContext).Settings.Current}" />
							<v:ChartInfoView
								IsVisible="{Binding Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ChartInfo}" />
						</Panel>
						<!-- 拖拽模式遮罩:按住面板任意位置即可拖动;平时隐藏,不影响 tab 拖拽 -->
						<Border Background="#4DFFFFFF"
								IsVisible="{Binding IsActive, Source={x:Static vm:DockDragModeState.Instance}}"
								DockProperties.IsDragArea="True"
								DockProperties.IsDragEnabled="{Binding CanDrag}" />
					</Grid>
				</DataTemplate>
			</dock:DockControl.DataTemplates>
		</dock:DockControl>
	</Grid>

</UserControl>
