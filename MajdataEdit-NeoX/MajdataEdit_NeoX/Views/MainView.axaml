<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

			 xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
			 xmlns:vm="using:MajdataEdit_NeoX.ViewModels"
			 xmlns:ll="clr-namespace:Avalonia.PropertyGrid.Localization;assembly=Avalonia.PropertyGrid"
			 xmlns:v="using:MajdataEdit_NeoX.Views"
			 xmlns:c="using:MajdataEdit_NeoX.Controls"

			 mc:Ignorable="d"
			 d:DesignWidth="630" d:DesignHeight="440"
			 x:Class="MajdataEdit_NeoX.Views.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*">
		<Menu Grid.Row="0">
			<MenuItem Header="{ll:Localize Gui_File}">
				<MenuItem Header="{ll:Localize Gui_New}" Command="{Binding NewFileAsync}"/>
				<MenuItem Header="{ll:Localize Gui_Open}" Command="{Binding OpenFileAsync}"/>
				<MenuItem Header="{ll:Localize Gui_Save}" Command="{Binding SaveFileAsync}"/>
				<MenuItem Header="{ll:Localize Gui_Reload}" Command="{Binding ReloadFile}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Win_Recover}" Command="{Binding OpenRecover}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Gui_ExportVideo}" Command="{Binding Play}" CommandParameter="WsType:PlaybackMode.Record"/>
			</MenuItem>
			<MenuItem x:Name="EditMenu" Header="{ll:Localize Gui_Edit}">
				<MenuItem Header="{ll:Localize Gui_ChartInfo}" Command="{Binding OpenChartInfo}"/>
				<Separator/>
				<MenuItem Header="{ll:Localize Gui_FindAndReplace}" Command="{Binding ShowFindReplace}"/>
				<Separator/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_Setting}">
				<MenuItem Header="{ll:Localize Gui_Setting}" Command="{Binding OpenSettings}"/>
				<MenuItem Header="{ll:Localize Gui_CheckUpdate}" Command="{Binding CheckUpdateAsync}" CommandParameter="false"/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_Tools}">
				<MenuItem Header="{ll:Localize Gui_BpmTap}" Command="{Binding OpenBpmTap}"/>
				<Separator/>
			</MenuItem>
			<MenuItem Header="{ll:Localize Gui_About}">
				<MenuItem Header="{ll:Localize Gui_ShortcutOverview}" Command="{Binding OpenShortcut}"/>
				<Separator/>
				<MenuItem Header="Discord" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.Discord}"/>
				<MenuItem Header="QQ" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.QQ}"/>
				<Separator/>
				<MenuItem Header="Github" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.GitHub}"/>
				<MenuItem Header="Github (ViewX)" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.GitHub_ViewX}"/>
				<MenuItem Header="Majnet" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static vm:AboutPages.MajNet}"/>
			</MenuItem>
		</Menu>

		<dock:DockControl Grid.Row="1"
						  Layout="{Binding Layout}"
						  InitializeLayout="True">
			<DockControl.DataTemplates>

				<DataTemplate DataType="vm:InspectorTool">
					<v:InspectorView
						x:DataType="vm:MainViewModel"
						DataContext="{Binding Context}"
						DisplayTime="{Binding PlayheadTime}"
						DisplayCombo="{Binding CaretCombo}"
						IsConnected="{Binding IsConnected}"
						SelectedDifficulty="{Binding SelectedDifficulty}"
						Level="{Binding Level}"
						Designer="{Binding Designer}"
						Offset="{Binding Offset}"
						PlaybackSpeed="{Binding PlaybackSpeed}"
						IsFollowCursor="{Binding IsFollowCursor}" />
				</DataTemplate>
				<DataTemplate DataType="vm:VisualizerTool">
					<!-- TODO: Signature -->
					<c:SimaiVisualizerControl
						x:DataType="vm:MainViewModel"
						DataContext="{Binding Context}"
						Time="{Binding PlayheadTime}"
						ZoomLevel="{Binding ZoomLevel}"
						TrackInfo="{Binding TrackInfo}"
						Chart="{Binding Chart}"
						Offset="{Binding Offset}"
						CaretTime="{Binding CaretTime}"
						IsAnimated="{Binding WaveAnimated}"
						/>
				</DataTemplate>
				<DataTemplate DataType="vm:EditorTool">
					<v:FumenEditorView
						x:DataType="vm:MainViewModel"
						DataContext="{Binding Context}"
						Fumen="{Binding Fumen}"
						FontSize="{Binding FontSize}"
						WordWrap="{Binding WordWrap}"
						CaretOffset="{Binding CaretOffset}"
						/>
				</DataTemplate>
				<!-- TODO: Cover -->
				<DataTemplate DataType="vm:ChartInfoTool">
					<v:ChartInfoView
						x:DataType="vm:MainViewModel"
						Maidata="{Binding Maidata}"
						Cover="{Binding Cover}"
						/>
				</DataTemplate>
				<DataTemplate DataType="vm:SettingsTool">
					<v:SettingsView
						x:DataType="vm:MainViewModel"
						Settings="{Binding Settings.Current}"
						SettingsChanged="{Binding RefreshSettings}"
						/>
				</DataTemplate>
			</DockControl.DataTemplates>

		</dock:DockControl>
	</Grid>
</UserControl>
