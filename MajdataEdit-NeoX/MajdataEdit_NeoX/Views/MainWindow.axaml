<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:vm="using:MajdataEdit_NeoX.ViewModels"
        xmlns:views="using:MajdataEdit_NeoX.Views"

        mc:Ignorable="d"
        d:DesignWidth="630" d:DesignHeight="460"
        MinWidth="680" MinHeight="540"
        Width="680" Height="540"

        x:Class="MajdataEdit_NeoX.Views.MainWindow"
        Icon="/Assets/favicon.ico"
        Title="{Binding WindowTitle, Source={x:Static vm:MainViewModel.Instance}}">

    <views:MainView />
</Window>
