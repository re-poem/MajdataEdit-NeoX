<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

             xmlns:type="using:MajdataEdit_NeoX.Models.Fumen"
             xmlns:ll="clr-namespace:Avalonia.PropertyGrid.Localization;assembly=Avalonia.PropertyGrid"

             x:Class="MajdataEdit_NeoX.Views.ChartInfoView"
             x:Name="Root">

    <Grid ColumnDefinitions="3*,5*" Margin="10">
        <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="10" RowSpacing="10">
            <Image Grid.Row="0" Source="{Binding #Root.Cover}" Stretch="Uniform"/>
            <Button Grid.Row="1" Content="{ll:Localize Gui_SelectBgImage}" Command="{Binding #Root.OpenBgCover}" HorizontalAlignment="Stretch"/>
            <Button Grid.Row="2" Content="{ll:Localize Gui_SelectBgVideo}" Command="{Binding #Root.OpenBgVideo}" HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Margin="10" RowSpacing="10">
            <DockPanel Grid.Row="0" Margin="0 5 0 0">
                <Label DockPanel.Dock="Left" Content="{ll:Localize Gui_Title}"/>
                <TextBox Text="{Binding #Root.Maidata.Title}" Margin="20 0 0 0"/>
            </DockPanel>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*">
                <Label Grid.Column="0" Content="{ll:Localize Gui_Artist}"/>
                <TextBox Grid.Column="1" Text="{Binding #Root.Maidata.Artist}" Margin="14 0 0 0"/>
                <Label Grid.Column="2" Margin="14 0 0 0" Content="{ll:Localize Gui_FinalDesigner}"/>
                <TextBox Grid.Column="3" Text="{Binding #Root.Maidata.Designer}" Margin="14 0 0 0"/>
            </Grid>
            <Label Grid.Row="2" Content="{ll:Localize Gui_Commands}"/>
            <ScrollViewer Grid.Row="3">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding #Root.Maidata.Commands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="type:MutSimaiCommand" x:DataType="type:MutSimaiCommand">
                                <Grid Margin="0 0 0 5" ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="5">
                                    <Label Grid.Column="0" Margin="0 3.5 0 0">&amp;</Label>
                                    <TextBox Grid.Column="1" Text="{Binding Key}"/>
                                    <Label Grid.Column="2" Margin="0 3.5 0 0">=</Label>
                                    <TextBox Grid.Column="3" Text="{Binding Value}"/>
                                    <Button Grid.Column="4" VerticalAlignment="Stretch"
                                            Command="{Binding #Root.DeleteCommand}"
                                            CommandParameter="{Binding}">-</Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding #Root.AddCommand}">+</Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
