<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>MajdataEdit_NeoX</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<Version>6.3.0</Version>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles Include="Assets\Localizations\en-US.json" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\MajdataEdit_NeoX.Generators\MajdataEdit_NeoX.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
		<PackageReference Include="Avalonia.Skia" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="AvaloniaEdit.TextMate" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Cimai" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" />
		<PackageReference Include="Dock.Model" />
		<PackageReference Include="Dock.Model.Mvvm" />
		<PackageReference Include="Dock.Serializer.SystemTextJson" />
		<PackageReference Include="FFmpeg.AutoGen" />
		<PackageReference Include="FluentAvaloniaUI" />
		<PackageReference Include="MajProtocol.Standard" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="NuGet.Versioning" />
		<PackageReference Include="NLua" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="PropertyGenerator.Avalonia" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" />
		<PackageReference Include="WebSocketSharp-netstandard" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../ThirdParty/Avalonia.PropertyGrid/Sources/Avalonia.PropertyGrid/Avalonia.PropertyGrid.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Assets\Localizations\" />
		<Folder Include="Docs\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="simai.tmLanguage.json" />
		<EmbeddedResource Include="xxlb.png" />
		<EmbeddedResource Include="Plugins\*.lua" />
	</ItemGroup>

</Project>
