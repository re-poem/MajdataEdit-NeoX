<Project>

	<!--
    miniaudio native build.

    Set these in the importing csproj BEFORE the <Import>:
      MiniaOutputTarget   desktop | ios | android   (required; nothing happens if empty)
      MiniaOutputDir      optional, relative to the importing project (default: obj/miniaudio/)
      MiniaudioRoot       optional, path to the miniaudio submodule
                          (default: <this file>/../../miniaudio/  i.e. Native/ -> project/ -> solution/)
    Android additionally: MiniaAndroidClang, MiniaAndroid{Arm64,Arm,X64,X86}Triple

    For desktop, the built library is added to the project's None items with
    Link=<file name>, so it lands in the output ROOT next to the app (where
    DllImport("miniaudio") actually probes) and flows to referencing projects
    and to publish.
  -->

	<PropertyGroup Label="Miniaudio settings">
		<MiniaudioRoot Condition="'$(MiniaudioRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\ThirdParty\miniaudio\</MiniaudioRoot>
		<MiniaudioRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(MiniaudioRoot)'))</MiniaudioRoot>
		<!--
      Compile our own translation unit instead of the submodule's miniaudio.c:
      it additionally pulls in extras/stb_vorbis.c so that Ogg/Vorbis decoding
      exists at all. See miniaudio_vorbis.c for why.
    -->
		<MiniaudioSourceFile>$(MSBuildThisFileDirectory)miniaudio_vorbis.c</MiniaudioSourceFile>
		<MiniaudioHeaderFile>$(MiniaudioRoot)miniaudio.h</MiniaudioHeaderFile>
		<MiniaudioVorbisFile>$(MiniaudioRoot)extras\stb_vorbis.c</MiniaudioVorbisFile>
		<!-- Include path for the submodule; trailing separator stripped so it survives quoting. -->
		<MiniaudioIncludePath>$(MiniaudioRoot.TrimEnd('\').TrimEnd('/'))</MiniaudioIncludePath>

		<!-- miniaudio_vorbis.c does #define MINIAUDIO_IMPLEMENTATION + #include "miniaudio.h" (+ stb_vorbis) -->
		<MiniaudioDefines Condition="'$(MiniaudioDefines)' == ''">MA_ENABLE_ONLY_SPECIFIC_BACKENDS;MA_NO_ENCODING;MA_NO_DEVICE_IO;MA_NO_RESOURCE_MANAGER;MA_NO_NODE_GRAPH;MA_NO_ENGINE</MiniaudioDefines>
		<_MiniaClDefines>/D $(MiniaudioDefines.Replace(';', ' /D '))</_MiniaClDefines>
		<_MiniaCcDefines>-D$(MiniaudioDefines.Replace(';', ' -D'))</_MiniaCcDefines>

		<MiniaCC Condition="'$(MiniaCC)' == ''">cc</MiniaCC>
		<MiniaIosMinVersion Condition="'$(MiniaIosMinVersion)' == ''">13.0</MiniaIosMinVersion>

		<MiniaOutputDir Condition="'$(MiniaOutputDir)' == ''">$(BaseIntermediateOutputPath)ThirdParty\miniaudio\</MiniaOutputDir>
		<_MiniaOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(MiniaOutputDir)'))</_MiniaOutDir>
		<_MiniaObjDir>$([MSBuild]::NormalizeDirectory('$(_MiniaOutDir)', 'obj'))</_MiniaObjDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MiniaOutputTarget)' == 'desktop'">
		<_MiniaLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">miniaudio.dll</_MiniaLibName>
		<_MiniaLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libminiaudio.dylib</_MiniaLibName>
		<_MiniaLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libminiaudio.so</_MiniaLibName>
	</PropertyGroup>

	<ItemGroup Condition="'$(MiniaOutputTarget)' == 'android'">
		<_MiniaAbi Include="arm64-v8a"   Triple="$(MiniaAndroidArm64Triple)" Condition="'$(MiniaAndroidArm64Triple)' != ''" />
		<_MiniaAbi Include="armeabi-v7a" Triple="$(MiniaAndroidArmTriple)"   Condition="'$(MiniaAndroidArmTriple)' != ''" />
		<_MiniaAbi Include="x86_64"      Triple="$(MiniaAndroidX64Triple)"   Condition="'$(MiniaAndroidX64Triple)' != ''" />
		<_MiniaAbi Include="x86"         Triple="$(MiniaAndroidX86Triple)"   Condition="'$(MiniaAndroidX86Triple)' != ''" />
	</ItemGroup>

	<!--
    Entry point. Hooked before BeforeBuild (NOT BeforeTargets="Build": that runs
    after CoreBuild, i.e. after files were already copied to the output).
  -->
	<Target Name="BuildMiniaudio"
			Condition="'$(MiniaOutputTarget)' != ''"
			BeforeTargets="BeforeBuild"
			DependsOnTargets="_MiniaBuildDesktop;_MiniaBuildIos;_MiniaBuildAndroid">
		<ItemGroup Condition="'$(MiniaOutputTarget)' == 'desktop' and '$(_MiniaLibName)' != ''">
			<None Include="$(_MiniaOutDir)$(_MiniaLibName)"
				  Link="$(_MiniaLibName)"
				  CopyToOutputDirectory="PreserveNewest"
				  CopyToPublishDirectory="PreserveNewest"
				  Visible="false" />
		</ItemGroup>
	</Target>

	<Target Name="_MiniaCheckSource">
		<Error Condition="!Exists('$(MiniaudioSourceFile)')"
			   Text="miniaudio source not found at '$(MiniaudioSourceFile)'. Run 'git submodule update --init --recursive', or set MiniaudioRoot." />
		<Error Condition="!Exists('$(MiniaudioHeaderFile)')"
			   Text="miniaudio header not found at '$(MiniaudioHeaderFile)'. Run 'git submodule update --init --recursive', or set MiniaudioRoot." />
		<Error Condition="!Exists('$(MiniaudioVorbisFile)')"
			   Text="stb_vorbis not found at '$(MiniaudioVorbisFile)'. Run 'git submodule update --init --recursive', or set MiniaudioRoot." />
	</Target>

	<!-- ===================== Desktop ===================== -->

	<!-- Plain `dotnet build` doesn't set up the VS dev env, so locate vcvarsall.bat via vswhere. -->
	<Target Name="_MiniaFindMsvc" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PropertyGroup>
			<_MiniaVsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_MiniaVsWhere>
		</PropertyGroup>

		<Exec Condition="'$(VCINSTALLDIR)' == '' and Exists('$(_MiniaVsWhere)')"
			  Command='"$(_MiniaVsWhere)" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath'
			  ConsoleToMSBuild="true"
			  StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_MiniaVsRoot" />
		</Exec>

		<PropertyGroup>
			<_MiniaVcVars Condition="'$(VCINSTALLDIR)' != ''">$([MSBuild]::NormalizePath('$(VCINSTALLDIR)', 'Auxiliary', 'Build', 'vcvarsall.bat'))</_MiniaVcVars>
			<_MiniaVcVars Condition="'$(_MiniaVcVars)' == '' and '$(_MiniaVsRoot)' != ''">$([MSBuild]::NormalizePath('$(_MiniaVsRoot.Trim())', 'VC', 'Auxiliary', 'Build', 'vcvarsall.bat'))</_MiniaVcVars>
		</PropertyGroup>

		<Error Condition="'$(_MiniaVcVars)' == '' or !Exists('$(_MiniaVcVars)')"
			   Text="MSVC (C++ build tools, x64) not found, cannot build miniaudio.dll. Install the 'Desktop development with C++' workload or the VS Build Tools." />
	</Target>

	<Target Name="_MiniaBuildDesktop"
			Condition="'$(MiniaOutputTarget)' == 'desktop'"
			DependsOnTargets="_MiniaCheckSource;_MiniaFindMsvc"
			Inputs="$(MiniaudioSourceFile);$(MiniaudioHeaderFile);$(MiniaudioVorbisFile);$(MSBuildThisFileFullPath)"
			Outputs="$(_MiniaOutDir)$(_MiniaLibName)">

		<Error Condition="'$(_MiniaLibName)' == ''" Text="miniaudio: unsupported desktop host OS." />
		<MakeDir Directories="$(_MiniaOutDir);$(_MiniaObjDir)" />

		<!-- Windows: /MT so users don't need the VC++ redistributable; MA_DLL makes MA_API dllexport. -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			  Command='call "$(_MiniaVcVars)" x64 &gt;NUL &amp;&amp; cl /nologo /LD /MT /O2 /W0 /D MA_DLL /I "$(MiniaudioIncludePath)" $(_MiniaClDefines) /Fo"$(_MiniaObjDir)miniaudio.obj" /Fe"$(_MiniaOutDir)miniaudio.dll" "$(MiniaudioSourceFile)"'
			  WorkingDirectory="$(_MiniaObjDir)" />
		<Delete Condition="$([MSBuild]::IsOSPlatform('Windows'))"
				Files="$(_MiniaOutDir)miniaudio.lib;$(_MiniaOutDir)miniaudio.exp" />

		<!-- macOS: universal (arm64 + x86_64) dylib. -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('OSX'))"
			  Command='$(MiniaCC) -dynamiclib -O2 -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -install_name @rpath/libminiaudio.dylib -I "$(MiniaudioIncludePath)" $(_MiniaCcDefines) -o "$(_MiniaOutDir)libminiaudio.dylib" "$(MiniaudioSourceFile)"' />

		<Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))"
			  Command='$(MiniaCC) -shared -fPIC -O2 -I "$(MiniaudioIncludePath)" $(_MiniaCcDefines) -o "$(_MiniaOutDir)libminiaudio.so" "$(MiniaudioSourceFile)" -lm -lpthread -ldl' />
	</Target>

	<!-- ===================== iOS ===================== -->

	<!--
    One static lib per RuntimeIdentifier. Device arm64 and simulator arm64 can't
    share one .a, so output goes to <out>/<rid>/libminiaudio.a. The iOS csproj
    should reference it as:
      <NativeReference Include="$(MiniaOutputDir)$(RuntimeIdentifier)/libminiaudio.a" Kind="Static" ForceLoad="true" />
  -->
	<Target Name="_MiniaPrepareIos">
		<PropertyGroup>
			<_MiniaIosRid>$(RuntimeIdentifier)</_MiniaIosRid>
			<_MiniaIosRid Condition="'$(_MiniaIosRid)' == ''">ios-arm64</_MiniaIosRid>
			<_MiniaIosSdk>iphoneos</_MiniaIosSdk>
			<_MiniaIosSdk Condition="$(_MiniaIosRid.StartsWith('iossimulator'))">iphonesimulator</_MiniaIosSdk>
			<_MiniaIosArch>arm64</_MiniaIosArch>
			<_MiniaIosArch Condition="$(_MiniaIosRid.EndsWith('-x64'))">x86_64</_MiniaIosArch>
			<_MiniaIosMinFlag>-miphoneos-version-min=$(MiniaIosMinVersion)</_MiniaIosMinFlag>
			<_MiniaIosMinFlag Condition="'$(_MiniaIosSdk)' == 'iphonesimulator'">-mios-simulator-version-min=$(MiniaIosMinVersion)</_MiniaIosMinFlag>
			<_MiniaIosOutDir>$([MSBuild]::NormalizeDirectory('$(_MiniaOutDir)', '$(_MiniaIosRid)'))</_MiniaIosOutDir>
		</PropertyGroup>
	</Target>

	<Target Name="_MiniaBuildIos"
			Condition="'$(MiniaOutputTarget)' == 'ios' and $([MSBuild]::IsOSPlatform('OSX'))"
			DependsOnTargets="_MiniaCheckSource;_MiniaPrepareIos"
			Inputs="$(MiniaudioSourceFile);$(MiniaudioHeaderFile);$(MiniaudioVorbisFile);$(MSBuildThisFileFullPath)"
			Outputs="$(_MiniaIosOutDir)libminiaudio.a">
		<MakeDir Directories="$(_MiniaIosOutDir);$(_MiniaObjDir)" />
		<Exec Command='xcrun --sdk $(_MiniaIosSdk) clang -arch $(_MiniaIosArch) $(_MiniaIosMinFlag) -O2 -I "$(MiniaudioIncludePath)" -c $(_MiniaCcDefines) -o "$(_MiniaObjDir)miniaudio-$(_MiniaIosRid).o" "$(MiniaudioSourceFile)"' />
		<Delete Files="$(_MiniaIosOutDir)libminiaudio.a" />
		<Exec Command='xcrun libtool -static -o "$(_MiniaIosOutDir)libminiaudio.a" "$(_MiniaObjDir)miniaudio-$(_MiniaIosRid).o"' />
	</Target>

	<!-- ===================== Android ===================== -->

	<!--
    Skipped (keeping any prebuilt .so) when MiniaAndroidClang isn't set.
    16 KB page alignment is required by Google Play for Android 15+ targets
    (NDK r28+ does this by default; the flag makes older NDKs comply too).
  -->
	<Target Name="_MiniaBuildAndroid"
			Condition="'$(MiniaOutputTarget)' == 'android' and '$(MiniaAndroidClang)' != ''"
			DependsOnTargets="_MiniaCheckSource"
			Inputs="$(MiniaudioSourceFile);$(MiniaudioHeaderFile);$(MiniaudioVorbisFile);$(MSBuildThisFileFullPath)"
			Outputs="@(_MiniaAbi->'$(_MiniaOutDir)%(Identity)/native/libminiaudio.so')">
		<MakeDir Directories="$(_MiniaOutDir)%(_MiniaAbi.Identity)/native" />
		<Exec Command='"$(MiniaAndroidClang)" --target=%(_MiniaAbi.Triple) -shared -fPIC -O2 -I "$(MiniaudioIncludePath)" -Wl,-z,max-page-size=16384 $(_MiniaCcDefines) -o "$(_MiniaOutDir)%(_MiniaAbi.Identity)/native/libminiaudio.so" "$(MiniaudioSourceFile)" -lm' />
	</Target>

</Project>
