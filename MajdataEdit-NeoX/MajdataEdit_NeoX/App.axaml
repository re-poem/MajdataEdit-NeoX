<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

			 xmlns:local="using:MajdataEdit_NeoX"
			 xmlns:vm="using:MajdataEdit_NeoX.ViewModels"
			 xmlns:ll="clr-namespace:Avalonia.PropertyGrid.Localization;assembly=Avalonia.PropertyGrid"
			 xmlns:v="using:MajdataEdit_NeoX.Views"
			 xmlns:c="using:MajdataEdit_NeoX.Controls"

			 x:Class="MajdataEdit_NeoX.App"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator />


		<DataTemplate DataType="vm:InspectorTool">
			<v:InspectorView
				x:DataType="vm:MainViewModel"
				DataContext="{Binding Context}"
				DisplayTime="{Binding PlayheadTime}"
				DisplayCombo="{Binding CaretCombo}"
				IsConnected="{Binding IsConnected}"
				ActiveConnectionCount="{Binding ActiveConnectionCount}"
				SelectedDifficulty="{Binding SelectedDifficulty}"
				Level="{Binding Level}"
				Designer="{Binding Designer}"
				Offset="{Binding Offset}"
				PlaybackSpeed="{Binding PlaybackSpeed}"
				IsFollowCursor="{Binding IsFollowCursor}" />
		</DataTemplate>
		<DataTemplate DataType="vm:VisualizerTool">
			<!-- TODO: Signature -->
			<c:SimaiVisualizerControl
				x:DataType="vm:MainViewModel"
				DataContext="{Binding Context}"
				Time="{Binding PlayheadTime}"
				ZoomLevel="{Binding ZoomLevel}"
				TrackInfo="{Binding TrackInfo}"
				Chart="{Binding Chart}"
				Offset="{Binding Offset}"
				CaretTime="{Binding CaretTime}"
				IsAnimated="{Binding WaveAnimated}"
				/>
		</DataTemplate>
		<DataTemplate DataType="vm:EditorTool">
			<v:FumenEditorView
				x:DataType="vm:MainViewModel"
				DataContext="{Binding Context}"
				Fumen="{Binding Fumen}"
				FontSize="{Binding FontSize}"
				WordWrap="{Binding WordWrap}"
				CaretOffset="{Binding CaretOffset}"
				/>
		</DataTemplate>
		<!-- TODO: Cover -->
		<DataTemplate DataType="vm:ChartInfoTool">
			<v:ChartInfoView
				x:DataType="vm:MainViewModel"
				DataContext="{Binding Context}"
				Maidata="{Binding Maidata}"
				Cover="{Binding Cover}"
				/>
		</DataTemplate>
		<DataTemplate DataType="vm:SettingsTool">
			<v:SettingsView
				x:DataType="vm:MainViewModel"
				DataContext="{Binding Context}"
				Settings="{Binding Settings.Current}"
				SettingsChanged="{Binding RefreshSettings}"
				/>
		</DataTemplate>
	</Application.DataTemplates>



	<!-- 窗口缩放动画需要WindowDecorations="Full"，但是会导致avalonia自己画导航，这里给它抹掉，经测试不能放在Window.Resources... -->
	<Application.Resources>
		<ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
			<Setter Property="Template">
				<WindowDrawnDecorationsTemplate>
					<WindowDrawnDecorationsContent>
						<WindowDrawnDecorationsContent.Overlay>
							<DockPanel Height="{TemplateBinding TitleBarHeight}"
									   VerticalAlignment="Top"
									   Margin="{TemplateBinding ShadowThickness}"/>
						</WindowDrawnDecorationsContent.Overlay>
					</WindowDrawnDecorationsContent>
				</WindowDrawnDecorationsTemplate>
			</Setter>
		</ControlTheme>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
		<DockFluentTheme />
	</Application.Styles>
</Application>
