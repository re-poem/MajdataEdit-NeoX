<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MajdataEdit_NeoX</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MajdataEdit_NeoX\MajdataEdit_NeoX.csproj" />
  </ItemGroup>

  <!--
    ffmpeg 原生库（波形解码用）来自同级的 MajdataViewX 仓库，以静态库形式链接进主可执行文件
    （ForceLoad 保证不被链接器裁掉）。libFFmpegUnityBridge 依赖 Unity，这里不带。
  -->
  <PropertyGroup>
    <FFmpegNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\MajdataViewX\Assets\Plugins\MajdataPlay\FFmpeg\Native'))</FFmpegNativeRoot>
    <FFmpegIosDir>$(FFmpegNativeRoot)\iOS</FFmpegIosDir>
  </PropertyGroup>

  <Target Name="CheckFFmpegIosNative" BeforeTargets="PrepareForBuild" Condition="!Exists('$(FFmpegIosDir)')">
    <Error Text="找不到 ffmpeg 原生库：$(FFmpegIosDir)。请把 MajdataViewX clone 到与本仓库同级的目录（$(FFmpegNativeRoot)）后再编译。" />
  </Target>

  <ItemGroup>
    <NativeReference Include="$(FFmpegIosDir)\libav*.a;$(FFmpegIosDir)\libsw*.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Link>%(Filename)%(Extension)</Link>
    </NativeReference>
  </ItemGroup>
</Project>
